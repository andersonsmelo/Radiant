@@ -0,0 +1,6 @@
+// INSTRUMENTAÇÃO DESCARTÁVEL (scratch), não versionada: linha do tempo do momento.
+export function mlog(tag: string, data?: unknown) {
+  const p = (globalThis as { performance?: { now?: () => number } }).performance?.now?.();
+  // eslint-disable-next-line no-console
+  console.log(`[MOMENT] t=${Date.now()} p=${p?.toFixed(1)} ${tag} ${data === undefined ? '' : JSON.stringify(data)}`);
+}
