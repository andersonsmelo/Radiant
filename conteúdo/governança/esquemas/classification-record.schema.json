{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Classification Record",
  "type": "object",
  "required": [
    "id",
    "sourceExcerptId",
    "sourceSlug",
    "galaxyId",
    "planetId",
    "starId",
    "confidence",
    "decisionReason",
    "reviewStatus"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "sourceExcerptId": {
      "type": "string"
    },
    "sourceSlug": {
      "type": "string"
    },
    "galaxyId": {
      "type": "string"
    },
    "planetId": {
      "type": "string"
    },
    "starId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Estrela de destino, ou null quando o planeta nao tem estrela. A taxonomia do eixo tecnico (2026-08-07) tem seis planetas sem estrela por decisao do dono: estrela e trilha curta complementar e nao ha nenhuma produzida. Exigir string aqui tornava esses planetas inalcancaveis pela classificacao."
    },
    "confidence": {
      "type": "number"
    },
    "decisionReason": {
      "type": "string"
    },
    "reviewStatus": {
      "type": "string"
    }
  }
}
