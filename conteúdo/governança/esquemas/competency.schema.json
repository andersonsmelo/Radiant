{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competency Track",
  "description": "Currículo espiral por competências. O campo `order` expressa a rota recomendada de estudo; `prerequisiteIds` expressa a dependência conceitual. Os dois são independentes por decisão da spec: revisões e reforços podem misturar unidades já apresentadas.",
  "type": "object",
  "required": [
    "schemaVersion",
    "trackId",
    "trackTitle",
    "version",
    "criticalSafetyCriterion",
    "units"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "trackId": { "type": "string", "pattern": "^track:[a-z0-9][a-z0-9-]*$" },
    "trackTitle": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "criticalSafetyCriterion": {
      "type": "string",
      "minLength": 20,
      "description": "Define o que `criticalSafety: true` significa nesta trilha. Existe para que a marcação seja auditável em vez de arbitrária: sem o critério escrito, cada revisor aplica um limiar diferente."
    },
    "units": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "required": ["id", "slug", "order", "title", "competencies"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^unit:[a-z0-9][a-z0-9-]*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "order": { "type": "integer", "minimum": 1, "maximum": 6 },
        "title": { "type": "string", "minLength": 1 },
        "competencies": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/competency" }
        }
      }
    },
    "competency": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "order",
        "objective",
        "criticalSafety",
        "prerequisiteIds",
        "evidenceMethods"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^competency:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "order": { "type": "integer", "minimum": 1, "maximum": 5 },
        "objective": {
          "type": "string",
          "minLength": 20,
          "description": "Comportamento observável, redigido no infinitivo. Verbos de estado interno (entender, saber, conhecer, compreender) são recusados pelo validador porque não produzem evidência avaliável."
        },
        "criticalSafety": {
          "type": "boolean",
          "description": "Verdadeiro quando um erro nesta competência tem consequência de segurança, e não apenas lacuna de conhecimento. Governa a regra de checkpoint 'nenhum erro crítico de segurança'."
        },
        "prerequisiteIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^competency:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "evidenceMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "guided-practice",
              "independent-recall",
              "applied-transfer",
              "delayed-retention"
            ]
          }
        }
      }
    }
  }
}
