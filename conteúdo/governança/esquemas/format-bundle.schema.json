{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format Bundle",
  "type": "object",
  "required": [
    "id",
    "formatType",
    "title",
    "sourceId",
    "sourceSlug",
    "taxonomyVersion",
    "generationStrategy",
    "conceptIds",
    "sourceExcerptIds",
    "reviewStatus",
    "payload"
  ],
  "properties": {
    "id": { "type": "string" },
    "formatType": {
      "type": "string",
      "enum": ["microlições", "quizzes"]
    },
    "title": { "type": "string" },
    "sourceId": { "type": "string" },
    "sourceSlug": { "type": "string" },
    "taxonomyVersion": { "type": "string" },
    "generationStrategy": { "type": "string" },
    "conceptIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceExcerptIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["approved", "needs-review"]
    },
    "payload": { "type": "object" }
  }
}
