{
  "schemaVersion": 1,
  "measuredAt": "2026-10-25",
  "policy": {
    "roots": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "relative and @/* imports reachable from src (root, then src, per tsconfig)"
    ],
    "excludedSources": [
      "*.test.*",
      "*.spec.*",
      "*.stories.*",
      "__tests__",
      "__mocks__",
      "test-utils",
      "*.d.ts"
    ],
    "clinical": [
      {
        "sources": [
          "src/data/lessons.ts",
          "src/data/ai-lessons.ts"
        ],
        "fields": [
          "questions.*"
        ]
      },
      {
        "sources": [
          "src/data/journey/defaultBlocks.ts"
        ],
        "fields": [
          "payload.prompt",
          "payload.explanation",
          "payload.options.*",
          "teach/reinforce.payload.body"
        ]
      },
      {
        "sources": [
          "src/features/bench/lessons/exposicao.ts",
          "src/features/bench/lessons/colimacao.ts"
        ],
        "fields": [
          "prompt",
          "body",
          "explanation",
          "options.*"
        ]
      },
      {
        "sources": [
          "src/features/curriculum-v3/l1-body-reference/l1BodyReferenceContent.ts",
          "src/features/curriculum-v3/l2-slicing-space/l2SlicingSpaceContent.ts"
        ],
        "fields": [
          "challenges.*",
          "relationships.*",
          "modelLayers.*",
          "sources.*"
        ]
      }
    ],
    "legal": {
      "source": "src/features/subscription/screens/SubscriptionScreen.tsx",
      "fields": [
        "CANCEL_COPY",
        "Text[style=styles.legal].children"
      ]
    },
    "metadata": {
      "source": "src/features/student-checkpoints/EditorialCurriculumCandidate.ts",
      "fields": [
        "sources.*",
        "LICENSE.label"
      ]
    },
    "infrastructure": [
      "fetch request init/body (including its serialized payload)"
    ],
    "internal": [
      "comments",
      "types",
      "imports",
      "conditions/discriminants",
      "routes",
      "testIDs",
      "storage keys",
      "icon names"
    ]
  },
