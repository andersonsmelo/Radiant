{
  "expo": {
    "name": "Radiant",
    "slug": "radiant-app",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "radiantapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ascendcreative.radiant",
      "buildNumber": "2",
      "usesNonExemptEncryption": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationUsageDescription": "Radiant usa notificações para lembrar revisões e metas diárias de estudo."
      }
    },
    "android": {
      "package": "com.ascendcreative.radiant",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#07091c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0A84FF",
          "defaultChannel": "study-reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#03030d",
          "dark": {
            "backgroundColor": "#03030d"
          }
        }
      ],
      "@sentry/react-native",
      "./plugins/with-gradle-memory"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "appEnv": "production",
      "router": {},
      "eas": {
        "projectId": "9c56e062-b004-4c54-b646-8b9e90770103"
      }
    },
    "owner": "hashi1802",
    "updates": {
      "url": "https://u.expo.dev/9c56e062-b004-4c54-b646-8b9e90770103"
    }
  }
}
