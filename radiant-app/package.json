{
  "name": "radiant-app",
  "main": "expo-router/entry",
  "version": "1.3.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:v2": "bash ./scripts/start-ios-v2.sh",
    "ios:doctor": "bash ./scripts/check-ios-tooling.sh",
    "ios:preflight": "npm run quality && npm run ios:doctor",
    "app-store:ops-check": "node ./scripts/check-app-store-war-room.mjs",
    "app-store:ops-check:strict": "node ./scripts/check-app-store-war-room.mjs --strict",
    "app-store:ops-save": "node ./scripts/save-app-store-war-room.mjs",
    "release:preflight": "bash ./scripts/check-release-tooling.sh",
    "web": "expo start --web",
    "lint": "eslint src components constants hooks scripts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:flows": "jest --runInBand src/features/progress/screens/ProgressScreen.flow.test.tsx src/features/quiz/screens/QuizScreen.flow.test.tsx src/features/review/screens/ReviewScreen.flow.test.tsx src/features/rewards/screens/RewardScreen.flow.test.tsx src/features/checkpoint/screens/CheckpointScreen.flow.test.tsx src/features/journey/screens/JourneyHomeScreen.flow.test.tsx",
    "test:qa": "node --test scripts/visual-qa.test.mjs",
    "test:storybook-config": "node --test scripts/storybook-config.test.mjs",
    "test:maestro-contract": "node --test scripts/maestro-contract.test.mjs",
    "test:reanimated-easing-contract": "node --test scripts/reanimated-easing-contract.test.mjs",
    "test:tab-bar-clearance-contract": "node --test scripts/tab-bar-clearance-contract.test.mjs",
    "test:contrast-contract": "node --test scripts/contrast-contract.test.mjs",
    "test:identity-palette-contract": "node --test scripts/identity-palette-contract.test.mjs",
    "visual:qa": "node scripts/visual-qa.mjs",
    "visual:qa:strict": "node scripts/visual-qa.mjs --strict",
    "quality": "npm run lint && npm run typecheck && npm run test:qa && npm run test:storybook-config && npm run test:maestro-contract && npm run test:reanimated-easing-contract && npm run test:tab-bar-clearance-contract && npm run test:contrast-contract && npm run test:identity-palette-contract && npm run visual:qa:strict",
    "storybook": "STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "STORYBOOK_ENABLED=true expo start --android"
  },
  "dependencies": {
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "expo": "~54.0.32",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.22",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "^55.0.11",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@storybook/addon-ondevice-controls": "10.4.0",
    "@storybook/addon-ondevice-actions": "10.4.0",
    "@storybook/react-native": "10.4.0",
    "@storybook/react-native-ui-lite": "10.4.0",
    "storybook": "10.4.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eas-cli": "^16.27.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.10",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": "20.x"
  },
  "private": true
}
