{
  "cli": {
    "version": ">= 12.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_ENABLE_DEV_TOOLS": "true",
        "EXPO_PUBLIC_ENABLE_TELEMETRY_DEBUG_SCREEN": "true",
        "EXPO_PUBLIC_ENABLE_BETA_GATE": "true",
        "EXPO_PUBLIC_ENABLE_LEARNING_ROAD": "true",
        "EXPO_PUBLIC_ENABLE_REMOTE_SYNC": "false"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "e2e-test": {
      "extends": "development",
      "developmentClient": false,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_ENABLE_DEV_TOOLS": "false",
        "EXPO_PUBLIC_ENABLE_TELEMETRY_DEBUG_SCREEN": "false",
        "EXPO_PUBLIC_ENABLE_BETA_GATE": "false",
        "EXPO_PUBLIC_ENABLE_LEARNING_ROAD": "true",
        "EXPO_PUBLIC_ENABLE_PUSH": "false",
        "EXPO_PUBLIC_ENABLE_REMOTE_SYNC": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_ENABLE_DEV_TOOLS": "true",
        "EXPO_PUBLIC_ENABLE_TELEMETRY_DEBUG_SCREEN": "true",
        "EXPO_PUBLIC_ENABLE_BETA_GATE": "true",
        "EXPO_PUBLIC_ENABLE_LEARNING_ROAD": "true",
        "EXPO_PUBLIC_ENABLE_PUSH": "true",
        "EXPO_PUBLIC_ENABLE_REMOTE_SYNC": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ENABLE_DEV_TOOLS": "false",
        "EXPO_PUBLIC_ENABLE_TELEMETRY_DEBUG_SCREEN": "false",
        "EXPO_PUBLIC_ENABLE_BETA_GATE": "false",
        "EXPO_PUBLIC_ENABLE_LEARNING_ROAD": "true",
        "EXPO_PUBLIC_ENABLE_PUSH": "true",
        "EXPO_PUBLIC_ENABLE_REMOTE_SYNC": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6797078156"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
